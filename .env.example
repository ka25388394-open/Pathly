# pathly Environment Variables for Railway Deployment

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (Railway will provide PostgreSQL automatically)
# DATABASE_URL will be set by Railway PostgreSQL service

# Google Gemini API (Optional - for AI features)  
# GEMINI_API_KEY=your_gemini_api_key_here

# AI Settings
GEMINI_MODEL_DEEP=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash
TONE_REVIEWER_ENABLED=true
MOCK_AI=false
